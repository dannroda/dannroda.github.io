---
import { shortcodes } from '../shortcodes.mjs';
import type { Lang } from '../i18n';
import type { Item } from './util';
const { b, lang } = Astro.props as { b: Item; lang: Lang };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The ::game and ::store shortcodes' markup: a game block and a shortcode in a post look the same.
const html = b.game ? shortcodes.find((s) => s.name === (b.display === 'store' ? 'store' : 'game'))!.render({ slug: b.game }, { base, lang }) : '';
---

{html && <div class="b-game" set:html={html} />}
