---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import AiTag from '../../../components/AiTag.astro';
import { pages, slugOf } from '../../../posts';
import { games, list, storeName, isCard, repoOf, type Game } from '../../../games';
import { t, url, langs, term, fmtDate, type Lang } from '../../../i18n';

export async function getStaticPaths() {
	const { all } = await games();
	return langs.flatMap((lang) => all.map((game) => ({ params: { lang, slug: game.id }, props: { game } })));
}

const lang = Astro.params.lang as Lang;
const s = t[lang];
const { game } = Astro.props as { game: Game };
const d = game.data;
const own = game.own;
const storeText = d.short?.[lang] || d.short?.en || d.description;
const jamLine = d.jam && [d.jam.name, d.jam.theme && `${s.theme}: “${d.jam.theme}”`].filter(Boolean).join(' · ');
const short = own?.summary[lang] || storeText || jamLine;
const fallback = !own?.summary[lang] && d.short && !d.short[lang];
const role = own?.role[lang];
const authorship = own?.authorship ?? [];
const tr = (v: unknown) => [v].flat().filter(Boolean).map((x) => term(lang, String(x))).join(', ') || null;

// itch "More information" rows worth showing, in the order the page lists them.
const itchFacts = [
	[s.madeWith, 'Made with'],
	[s.platforms, 'Platforms'],
	[s.status, 'Status'],
	[s.aiDisclosure, 'AI Disclosure'],
	[s.aiDisclosure, 'Content']
] as const;
const facts = [
	[s.developer, d.developers?.join(', ')],
	[s.release, d.release_date],
	[s.platforms, d.platforms?.map((p) => ({ windows: 'Windows', mac: 'macOS', linux: 'Linux' })[p] ?? p).join(', ')],
	[s.price, d.price],
	[s.credits, d.authors?.map((a) => a.name).join(', ')],
	[s.language, d.language],
	[s.license, d.license],
	['Godot', d.godot_version],
	[s.version, d.version],
	[s.created, d.created && fmtDate(new Date(d.created), lang)],
	[s.status, d.archived ? s.archived : null],
	...itchFacts.map(([label, key]) => [label, key === 'Made with' ? list(d.info?.[key]) : tr(d.info?.[key])])
].filter(([, v]) => v) as [string, string][];
const synced = new Date(d.synced_at).toLocaleDateString(s.dateLocale, { dateStyle: 'long' });
const entries = d.jam?.entries;
// The project's own landing field wins over a CMS page that names this project.
const cmsLanding = (await pages(lang)).find((p) => p.data.project === game.id);
const ownLanding = own?.landing?.replace(/^\/+|\/+$/g, '');
const landing = ownLanding?.startsWith('https://') ? ownLanding : ownLanding ? url(`/${lang}/${ownLanding}/`) : cmsLanding ? url(`/${lang}/${slugOf(cmsLanding.id)}/`) : null;
const repo = repoOf(game);
const wiki = (await getCollection('wiki', (w) => w.data.wiki === game.id || w.data.repo.toLowerCase() === repo))[0]?.data.wiki;
---

<Base lang={lang} title={d.title} description={short ?? undefined} image={d.local_images.cover ?? undefined} path={`games/${game.id}/`}>
	<section class="detail-hero">
		<div class="intro-block">
			<h1 class="lede-h1" data-rise>{d.title}</h1>
			<div class="pills" data-rise>
				<AiTag lang={lang} level={own?.ai} />
				{role && <span class="small">{s.role}: {role}</span>}
			</div>
			{short && <p class="lead-text" lang={fallback ? 'en' : lang} data-rise>{short}</p>}
			{fallback && <p class="small">{s.onlyIn}</p>}
			<div class="pills" data-rise>
				<a class="pill primary" href={d.url}>{d.source === 'github' || d.source === 'assetlib' ? s.viewOn : s.play} {storeName[d.source]} ↗</a>
				{landing && <a class="pill" href={landing}>{s.projectPage}{landing.startsWith('https://') && ' ↗'}</a>}
				{repo && <a class="pill" href={`https://github.com/${repo}`}>{s.codeOn} GitHub ↗</a>}
				{wiki && <a class="pill" href={url(`/${lang}/wiki/${wiki}/`)}>{s.wiki}</a>}
				{d.homepage && <a class="pill" href={d.homepage}>{s.website} ↗</a>}
				{d.jam && <a class="pill" href={d.jam.url}>{d.jam.name} ↗</a>}
			</div>
		</div>
		{d.local_images.cover && <img class:list={["detail-cover", { wide: isCard(game) }]} src={url(d.local_images.cover)} alt="" data-rise />}
	</section>

	<div class="detail">
		<main>
			{
				authorship.length > 0 && (
					<section class="section" aria-labelledby="h-authorship" data-rise>
						<h2 id="h-authorship">{s.authorship}</h2>
						<div class="table-box">
							<table>
								<thead>
									<tr><th scope="col">{s.area}</th><th scope="col">{s.who}</th><th scope="col">{s.note}</th></tr>
								</thead>
								<tbody>
									{authorship.map((a) => (
										<tr>
											<th scope="row">{s.areas[a.area]}</th>
											<td><span class:list={['tag', a.who === 'me' ? 'hand' : a.who === 'ai' ? 'assisted' : 'other']}>{s.authors[a.who]}</span></td>
											<td>{a.note[lang] || a.note[lang === 'es' ? 'en' : 'es']}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)
			}
			{
				d.local_images.trailer && (
					<section class="section" aria-labelledby="h-trailer" data-rise>
						<h2 id="h-trailer">{s.trailer}</h2>
						<a class="trailer" href={d.url}>
							<img class="shot" src={url(d.local_images.trailer)} alt={d.trailer?.name ?? s.trailer} loading="lazy" />
							<span class="pill primary">▶ {s.viewOn} {storeName[d.source]}</span>
						</a>
					</section>
				)
			}
			{
				d.jam?.results && (
					<section class="section" aria-labelledby="h-results" data-rise>
						<h2 id="h-results">{s.results}</h2>
						{d.jam.theme && <p class="muted">{s.theme}: “{d.jam.theme}”</p>}
						<div class="table-box">
							<table>
								<thead>
									<tr><th scope="col">{s.category}</th><th scope="col">{s.rank}</th><th scope="col">{s.score}</th></tr>
								</thead>
								<tbody>
									{Object.entries(d.jam.results).map(([cat, r]) => (
										<tr>
											<th scope="row">{term(lang, cat)}</th>
											<td>#{r.rank}{entries && <span class="muted"> {s.of} {entries}</span>}</td>
											<td>{r.average.toFixed(2)}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)
			}
			{
				d.local_images.screenshots.length > 0 && (
					<section class="gallery" aria-label="Screenshots">
						{d.local_images.screenshots.map((src) => <img class="shot" src={url(src)} alt="" loading="lazy" data-rise />)}
					</section>
				)
			}
			<p class="small">{s.synced} {synced}</p>
		</main>

		{
			facts.length > 0 && (
				<dl class="facts">
					{facts.map(([k, v]) => (
						<div data-rise><dt>{k}</dt><dd>{v}</dd></div>
					))}
				</dl>
			)
		}
	</div>
</Base>
