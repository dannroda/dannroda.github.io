---
// Pages built from blocks in the admin: content/pages/<slug>.json, served at /<lang>/<slug>/.
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import { pages } from '../../posts';
import { games } from '../../games';
import { langs, type Lang } from '../../i18n';
import { tx } from '../../blocks/util';

export async function getStaticPaths() {
	// These names are already routes; a page with one of them would be silently shadowed.
	const taken = ['blog', 'games', 'wiki', 'links', 'admin-preview', 'admin-draft'];
	const ids = new Set((await games()).all.map((g) => g.id));
	const list = await pages();
	for (const page of list) {
		if (taken.includes(page.id)) throw new Error(`content/pages/${page.id}.json: "${page.id}" is taken by the site, rename the page`);
		if (page.data.project && !ids.has(page.data.project)) throw new Error(`content/pages/${page.id}.json: no game or project "${page.data.project}"`);
	}
	return langs.flatMap((lang) => list.map((page) => ({ params: { lang, page: page.id }, props: { page } })));
}

const lang = Astro.params.lang as Lang;
const { page } = Astro.props;
---

<Base lang={lang} title={tx(page.data.title, lang)} description={tx(page.data.description, lang) || undefined} image={page.data.image || undefined} path={`${page.id}/`} mode="home">
	<Blocks blocks={page.data.blocks} lang={lang} />
</Base>
