---
import Base from '../../layouts/Base.astro';
import AiTag from '../../components/AiTag.astro';
import { games } from '../../games';
import { url, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const game = (await games()).all.find((g) => g.id === 'godot-agent');

const repo = 'https://github.com/dannroda/godot-agent';
const version = 'v0.1.11';
// Loaded from the repo so they follow tests/docs_shots.sh, which regenerates them in both languages.
const shot = (name: string) => `https://raw.githubusercontent.com/dannroda/godot-agent/main/docs/images/${lang}/${name}.png`;

type D = 'allow' | 'ask' | 'deny';
const matrix: [string, D[], string?][] = [
	['read', ['allow', 'allow', 'allow', 'allow', 'allow']],
	['edit', ['deny', 'deny', 'ask', 'allow', 'allow']],
	['run', ['deny', 'ask', 'ask', 'allow', 'allow']],
	['shell', ['deny', 'deny', 'ask', 'ask', 'ask'], '*'],
	['project', ['deny', 'deny', 'ask', 'allow', 'allow']],
	['store', ['deny', 'deny', 'ask', 'ask', 'ask']]
];
const toolNames = [
	['scene_tree', 'get_node', 'class_info', 'search_api'],
	['add_nodes', 'set_properties', 'reparent_node', 'connect_signal'],
	['run_scene', 'capture_game_frame', 'game_input', 'game_wait'],
	['validate_scripts', 'validate_physics', 'validate_tilemap', 'get_errors'],
	['tileset_add_atlas', 'tilemap_paint_terrain', 'animation_set_track'],
	['move_file', 'create_resource', 'asset_search', 'asset_install']
];

const copy = {
	en: {
		title: 'Godot Agent Harness',
		description: 'Your coding agent, inside the Godot editor: Claude Code, Codex, Google Antigravity or any ACP agent, with the editor’s own tools, undo and permissions you choose.',
		h1: 'Your coding agent, <em>inside</em> the Godot editor.',
		intro: 'An editor addon for Godot 4. The agent reads and edits scenes and scripts with the editor’s own tools, with undo, runs the game and tests it. Every change goes through permissions you choose. Free and MIT licensed.',
		download: `Download ${version}`,
		wiki: 'Read the wiki',
		wikiHome: `${repo}/wiki`,
		anyAcp: 'any ACP agent',
		gdcs: 'GDScript & C#',
		overviewAlt: 'The Godot editor with an asteroids scene and the Agent dock: Claude Code planned three steps, ran five tools, showed the diff of spawner.gd and wired a wave counter into the HUD.',
		overviewCap: 'Build mode in Godot 4.7.2: the plan, each tool call, the diff and the answer stay in the dock, next to the scene they changed.',
		modesEyebrow: 'godot.* · permission policy',
		modesH: 'Five modes. You decide what each one may touch.',
		modesP: 'Every action belongs to a group, and each group has a decision per mode. Ask shows a card with the diff; Deny tells the agent why. The matrix lives in <code>project_config.tres</code>, so your team shares it.',
		permAlt: 'A permission request in the Agent dock: Edit player.gd, with the diff, and the buttons Allow once, Deny and Always allow in this session.',
		permCap: 'In Build, an edit waits for you above the composer, with its diff.',
		group: 'Group',
		modes: [
			['Ask', 'Answers about the project. Reads only.'],
			['Review', 'Findings as marks in the Script Editor.'],
			['Build', 'Edits and runs, asking first.'],
			['Auto', 'No cards for what can be undone.'],
			['One-shot', 'A whole goal, with budgets.']
		],
		groups: { read: 'Read & diagnostics', edit: 'Edit scenes & files', run: 'Run the game', shell: 'Shell commands', project: 'Project settings & export', store: 'Install from the Asset Store' },
		decisions: { allow: 'Allow', ask: 'Ask', deny: 'Deny' },
		matrixNote: '* In Auto, read-only and build commands on the allowlist run on their own; <code>rm</code>, <code>git push</code>, <code>curl</code> and installers always ask. In any mode, writing a <code>.tscn</code> by hand or a project file from the shell is rejected: scenes change only through the editor.',
		toolsEyebrow: 'MCP on 127.0.0.1',
		toolsH: '60+ editor tools. The agent uses Godot, not a text editor.',
		toolsP: 'Scene edits are steps in Godot’s own undo. Open scripts and unsaved buffers are respected. When the agent runs Godot from the shell, it uses the same binary as your editor.',
		tools: [
			['Read the project', 'Scene trees with non-default properties, one node in detail, editor state, and the API of any class in your exact Godot version.'],
			['Edit scenes', 'A whole subtree in one call and one undo step. Nothing is created if one item is invalid.'],
			['Run and look', 'Run a scene with simulated input, read the real errors, capture frames. Input plays by physics frame, so a run reproduces at any framerate. Playtest answers passed, failed or could not test, with evidence and optional video.'],
			['Check the work', 'Parse scripts without running, build C# with dotnet, and catch bodies without shapes or tiles without collision.'],
			['Tilemaps & animation', 'Turn a texture into an atlas, paint terrains, build AnimationPlayer tracks and SpriteFrames from a sheet.'],
			['Files & Asset Store', 'Moves keep the uid and rewrite every <code>res://</code> reference. Assets install into <code>addons/</code> without overwriting.']
		],
		oneshotEyebrow: 'One-shot screen · next to 2D / 3D / Script',
		oneshotH: 'Give it a whole game. Get a branch back.',
		oneshotP: '“A 2-player Pong with score.” The agent writes a spec, plans, builds, playtests and reports. A separate evaluator plays the result before anything counts as done. It never merges.',
		steps: [
			['Spec', '<code>spec.md</code>: mechanics, game loop, visual direction, what “done” means. You can review it before the build starts.'],
			['Plan', 'Tasks with live durations. Edit the plan while it runs; the agent rereads it after each turn.'],
			['Build and verify', 'Edit, <code>run_scene</code>, look at frames, read errors, report checks as pass, fail or pending.'],
			['Checkpoints', 'One <code>cpN</code> commit per task on <code>agent/&lt;date&gt;</code>. Restore any of them and resume from there.'],
			['QA', 'A new session that never saw the builder’s chat plays the game and scores playability, function, feel and code. It can’t edit.'],
			['Report', 'What the harness measured, not what the agent claims: time per task, tools, failures, loops, quota pauses.']
		],
		oneshotAlt: 'The One-shot screen running an asteroid shooter goal, task 2 of 3: quota, time, tokens and playtest bars, the plan, the activity log, the last playtest frame, two passed checks and one pending, and checkpoints cp1 to cp3 with Restore here.',
		oneshotCap: 'Pauses at 90 % of your plan quota, at the end of a task. Hit the limit and switch accounts without losing the session.',
		reviewEyebrow: 'Review mode',
		reviewH: 'Findings land on the line.',
		reviewP: 'Bugs, structure, performance and style show as marks in the Script Editor, with Apply fix, Ask and Dismiss. Pull a GitHub PR’s comments in as findings, or export the review to <code>CLAUDE.md</code> as conventions.',
		reviewAlt: 'The Script Editor showing hud.gd with a performance finding on line 8, get_node on every frame, its fix and the buttons Apply fix, Ask and Dismiss; the dock lists the review.',
		completionEyebrow: 'Inline completion',
		completionH: 'Grey suggestions, local by default.',
		completionP: 'Rules that know Godot, lines your project repeats, and an n-gram model of your code. No network unless you add Ollama, llama.cpp or another LLM.',
		keys: ['accept', 'word by word', 'ask the agent for a change'],
		rulesEyebrow: 'Ground rules',
		rulesH: 'What it will never do.',
		rules: [
			['Merge or push', 'One-shot works on its own branch. You review and you merge.'],
			['Store your API keys', 'Profiles name an environment variable; the value is read at request time.'],
			['Read the agent’s credentials', 'Sign-in runs the agent’s own login. Pasted codes never reach the log.'],
			['Listen beyond your machine', 'The MCP server binds to 127.0.0.1 with a token that changes on every start.'],
			['Ship in your game', 'Nothing from the addon reaches an exported build.']
		],
		installH: 'Three steps to the first prompt.',
		req: 'Godot 4.7 or newer. For Claude Code, Node.js with <code>npx</code>. For C#, Godot .NET and the .NET SDK. Linux, macOS and Windows. Interface in English and Spanish. MIT, free: the agent uses your own account with its provider.',
		downloadZip: `Download ${version} (zip)`,
		gettingStarted: 'Getting started',
		gettingStartedUrl: `${repo}/wiki/Getting-started`,
		install: [
			'Copy <code>addons/godot_agent/</code> into your project’s <code>addons/</code> folder.',
			'Project → Project Settings → Plugins → enable <b>Godot Agent Harness</b>.',
			'In the Agent dock, <b>Add</b> Claude Code (or another agent), sign in and <b>Start session</b>.'
		],
		privacy: 'Privacy',
		privacyUrl: `${repo}/blob/main/PRIVACY.md`,
		noTelemetry: 'No telemetry, no server of its own.'
	},
	es: {
		title: 'Godot Agent Harness',
		description: 'Tu agente de código, dentro del editor de Godot: Claude Code, Codex, Google Antigravity o cualquier agente ACP, con las herramientas del propio editor, deshacer y los permisos que elegís.',
		h1: 'Tu agente de código, <em>dentro</em> del editor de Godot.',
		intro: 'Un addon de editor para Godot 4. El agente lee y edita escenas y scripts con las herramientas del propio editor, con deshacer, corre el juego y lo prueba. Cada cambio pasa por los permisos que elegís. Gratis y con licencia MIT.',
		download: `Descargar ${version}`,
		wiki: 'Leer la wiki',
		wikiHome: `${repo}/wiki/Inicio`,
		anyAcp: 'cualquier agente ACP',
		gdcs: 'GDScript y C#',
		overviewAlt: 'El editor de Godot con una escena de asteroides y el dock Agent: Claude Code planificó tres pasos, corrió cinco herramientas, mostró el diff de spawner.gd y conectó un contador de oleadas al HUD.',
		overviewCap: 'Modo Construir en Godot 4.7.2: el plan, cada herramienta, el diff y la respuesta quedan en el dock, al lado de la escena que cambiaron.',
		modesEyebrow: 'godot.* · política de permisos',
		modesH: 'Cinco modos. Vos decidís qué puede tocar cada uno.',
		modesP: 'Cada acción pertenece a un grupo, y cada grupo tiene una decisión por modo. Preguntar muestra una tarjeta con el diff; Denegar le explica al agente por qué. La matriz vive en <code>project_config.tres</code>, así que tu equipo la comparte.',
		permAlt: 'Un pedido de permiso en el dock Agent: editar player.gd, con el diff, y los botones para permitir una vez, denegar o permitir siempre en esta sesión.',
		permCap: 'En Construir, una edición te espera arriba del composer, con su diff.',
		group: 'Grupo',
		modes: [
			['Preguntar', 'Responde sobre el proyecto. Solo lee.'],
			['Revisar', 'Hallazgos como marcas en el Script Editor.'],
			['Construir', 'Edita y corre, preguntando antes.'],
			['Auto', 'Sin tarjetas para lo que se puede deshacer.'],
			['One-shot', 'Un objetivo entero, con presupuestos.']
		],
		groups: { read: 'Leer y diagnósticos', edit: 'Editar escenas y archivos', run: 'Correr el juego', shell: 'Comandos de shell', project: 'Ajustes del proyecto y exportación', store: 'Instalar desde el Asset Store' },
		decisions: { allow: 'Permitir', ask: 'Preguntar', deny: 'Denegar' },
		matrixNote: '* En Auto, los comandos de lectura y compilación de la lista permitida corren solos; <code>rm</code>, <code>git push</code>, <code>curl</code> y los instaladores siempre preguntan. En cualquier modo, escribir un <code>.tscn</code> a mano o un archivo del proyecto desde la shell se rechaza: las escenas solo cambian a través del editor.',
		toolsEyebrow: 'MCP en 127.0.0.1',
		toolsH: 'Más de 60 herramientas. El agente usa Godot, no un editor de texto.',
		toolsP: 'Cada edición de escena es un paso del deshacer de Godot. Respeta los scripts abiertos y lo que no guardaste. Cuando el agente corre Godot desde la shell, usa el mismo binario que tu editor.',
		tools: [
			['Leer el proyecto', 'Árboles de escena con sus propiedades, un nodo en detalle, el estado del editor y la API de cualquier clase en tu versión exacta de Godot.'],
			['Editar escenas', 'Un subárbol entero en una llamada y un paso de deshacer. Si un ítem es inválido, no se crea nada.'],
			['Correr y mirar', 'Corre una escena con input simulado, lee los errores reales y captura frames. El input va por frame de física, así que la corrida se repite igual a cualquier framerate. Playtest contesta pasó, falló o no se pudo probar, con evidencia y video opcional.'],
			['Verificar el trabajo', 'Valida scripts sin correr el juego, compila C# con dotnet y detecta cuerpos sin forma o tiles sin colisión.'],
			['TileMaps y animación', 'Convierte una textura en atlas, pinta terrenos y arma pistas de AnimationPlayer y SpriteFrames desde una hoja.'],
			['Archivos y Asset Store', 'Mover conserva el uid y reescribe cada referencia <code>res://</code>. Los assets se instalan en <code>addons/</code> sin sobrescribir nada.']
		],
		oneshotEyebrow: 'Pantalla One-shot · al lado de 2D / 3D / Script',
		oneshotH: 'Pedile un juego entero. Recibí una rama.',
		oneshotP: '«Un Pong de 2 jugadores con puntaje.» El agente escribe una spec, planifica, construye, prueba y reporta. Un evaluador aparte juega el resultado antes de darlo por terminado. Nunca hace merge.',
		steps: [
			['Spec', '<code>spec.md</code>: mecánicas, ciclo de juego, dirección visual y qué significa «terminado». Podés revisarla antes de que empiece.'],
			['Plan', 'Tareas con su duración en vivo. Editá el plan mientras corre; el agente lo relee después de cada turno.'],
			['Construir y verificar', 'Edita, <code>run_scene</code>, mira capturas, lee errores y reporta checks como pass, fail o pending.'],
			['Checkpoints', 'Un commit <code>cpN</code> por tarea en <code>agent/&lt;fecha&gt;</code>. Restaurá cualquiera y seguí desde ahí.'],
			['QA', 'Una sesión nueva, que nunca vio el chat del constructor, juega y puntúa jugabilidad, funcionalidad, sensación y código. No puede editar.'],
			['Reporte', 'Lo que midió el harness, no lo que dice el agente: tiempo por tarea, herramientas, fallas, loops y pausas por cuota.']
		],
		oneshotAlt: 'La pantalla One-shot con el objetivo de un shooter de asteroides, tarea 2 de 3: barras de cuota, tiempo, tokens y playtests, el plan, la actividad, el frame del último playtest, dos checks pasados y uno pendiente, y los checkpoints cp1 a cp3.',
		oneshotCap: 'Se pausa al 90 % de la cuota de tu plan, al terminar una tarea. Si llegás al límite, cambiás de cuenta sin perder la sesión.',
		reviewEyebrow: 'Modo Revisar',
		reviewH: 'Los hallazgos caen en la línea.',
		reviewP: 'Bugs, estructura, rendimiento y estilo aparecen como marcas en el Script Editor, con Aplicar arreglo, Preguntar y Descartar. Traé los comentarios de un PR de GitHub como hallazgos, o exportá la revisión a <code>CLAUDE.md</code> como convenciones.',
		reviewAlt: 'El Script Editor con hud.gd y un hallazgo de rendimiento en la línea 8, get_node en cada frame, su arreglo y los botones para aplicarlo, preguntar o descartarlo; el dock lista la revisión.',
		completionEyebrow: 'Completado inline',
		completionH: 'Sugerencias en gris, locales por defecto.',
		completionP: 'Reglas que conocen Godot, líneas que tu proyecto repite y un modelo n-gram de tu código. Sin red, salvo que agregues Ollama, llama.cpp u otro LLM.',
		keys: ['aceptar', 'palabra por palabra', 'pedirle un cambio al agente'],
		rulesEyebrow: 'Reglas',
		rulesH: 'Lo que nunca va a hacer.',
		rules: [
			['Hacer merge o push', 'One-shot trabaja en su propia rama. Vos revisás y vos hacés el merge.'],
			['Guardar tus API keys', 'Los perfiles nombran una variable de entorno; el valor se lee en cada pedido.'],
			['Leer las credenciales del agente', 'El inicio de sesión usa el login del propio agente. Los códigos pegados nunca llegan al log.'],
			['Escuchar fuera de tu máquina', 'El servidor MCP escucha solo en 127.0.0.1, con un token que cambia en cada arranque.'],
			['Viajar en tu juego', 'Nada del addon llega a un juego exportado.']
		],
		installH: 'Tres pasos hasta el primer prompt.',
		req: 'Godot 4.7 o más nuevo. Para Claude Code, Node.js con <code>npx</code>. Para C#, Godot .NET y el SDK de .NET. Linux, macOS y Windows. Interfaz en inglés y español. MIT y gratis: el agente usa tu propia cuenta con su proveedor.',
		downloadZip: `Descargar ${version} (zip)`,
		gettingStarted: 'Primeros pasos',
		gettingStartedUrl: `${repo}/wiki/Primeros-pasos`,
		install: [
			'Copiá <code>addons/godot_agent/</code> en la carpeta <code>addons/</code> de tu proyecto.',
			'Proyecto → Configuración del proyecto → Plugins → habilitá <b>Godot Agent Harness</b>.',
			'En el dock Agent, tocá <b>Agregar</b> en Claude Code (u otro agente), entrá con tu cuenta y tocá <b>Iniciar sesión</b>.'
		],
		privacy: 'Privacidad',
		privacyUrl: `${repo}/blob/main/PRIVACY.es.md`,
		noTelemetry: 'Sin telemetría ni servidor propio.'
	}
}[lang];
const release = `${repo}/releases/latest`;
---

<Base lang={lang} title={copy.title} description={copy.description} image={game?.data.local_images.cover ?? undefined} path="godot-agent/" mode="home">
	<div class="ga">
		<section class="ga-hero" aria-labelledby="h-hero" style={`--pattern: url(${url('/godot-pattern.svg')})`}>
			<div class="hero-bg" aria-hidden="true"></div>
			<div class="ga-hero-text">
				<h1 id="h-hero" set:html={copy.h1} />
				<div class="ga-hero-side">
					<p class="ga-lead" set:html={copy.intro} />
					<div class="pills">
						<a class="pill primary" href={release}>{copy.download}</a>
						<a class="pill" href={copy.wikiHome}>{copy.wiki}</a>
					</div>
					<div class="ga-agents">
						<AiTag lang={lang} level={game?.own?.ai} />
						<span>Claude Code</span><span>Codex</span><span>Google Antigravity</span><span>{copy.anyAcp}</span><span>{copy.gdcs}</span>
					</div>
				</div>
			</div>
			<figure class="ga-shot">
				<img src={shot('overview')} width="1920" height="1200" alt={copy.overviewAlt} />
				<figcaption>{copy.overviewCap}</figcaption>
			</figure>
		</section>

		<section id="modes" class="ga-section" aria-labelledby="h-modes">
			<div class="ga-head">
				<span class="ga-eyebrow">{copy.modesEyebrow}</span>
				<h2 id="h-modes">{copy.modesH}</h2>
				<p set:html={copy.modesP} />
			</div>
			<div class="ga-modes">
				<figure class="ga-shot ga-perm">
					<img src={shot('permission')} width="480" height="1108" loading="lazy" alt={copy.permAlt} />
					<figcaption>{copy.permCap}</figcaption>
				</figure>
				<div class="ga-modes-main">
					<div class="ga-matrix">
						<table>
							<thead>
								<tr>
									<th scope="col">{copy.group}</th>
									{copy.modes.map(([name, what]) => <th scope="col">{name}<small>{what}</small></th>)}
								</tr>
							</thead>
							<tbody>
								{matrix.map(([key, row, mark]) => (
									<tr>
										<th scope="row">{copy.groups[key as keyof typeof copy.groups]}</th>
										{row.map((d, i) => <td><span class={`ga-d ${d}`}>{copy.decisions[d]}{mark && i === 3 ? mark : ''}</span></td>)}
									</tr>
								))}
							</tbody>
						</table>
					</div>
					<p class="small" set:html={copy.matrixNote} />
				</div>
			</div>
		</section>

		<section id="tools" class="ga-section" aria-labelledby="h-tools">
			<div class="ga-head">
				<span class="ga-eyebrow">{copy.toolsEyebrow}</span>
				<h2 id="h-tools">{copy.toolsH}</h2>
				<p>{copy.toolsP}</p>
			</div>
			<div class="ga-tools">
				{copy.tools.map(([name, what], i) => (
					<div class="ga-tool">
						<h3>{name}</h3>
						<p set:html={what} />
						<div class="ga-names">{toolNames[i].map((n) => <span>{n}</span>)}</div>
					</div>
				))}
			</div>
		</section>

		<section id="oneshot" class="ga-section" aria-labelledby="h-oneshot">
			<div class="ga-head">
				<span class="ga-eyebrow">{copy.oneshotEyebrow}</span>
				<h2 id="h-oneshot">{copy.oneshotH}</h2>
				<p>{copy.oneshotP}</p>
			</div>
			<div class="ga-oneshot">
				<ol class="ga-steps">
					{copy.steps.map(([name, what]) => <li><b>{name}</b><span set:html={what} /></li>)}
				</ol>
				<figure class="ga-shot ga-run">
					<img src={shot('oneshot')} width="1134" height="1073" loading="lazy" alt={copy.oneshotAlt} />
					<figcaption>{copy.oneshotCap}</figcaption>
				</figure>
			</div>
		</section>

		<section class="ga-section ga-pair">
			<div class="ga-panel">
				<span class="ga-eyebrow">{copy.reviewEyebrow}</span>
				<h3>{copy.reviewH}</h3>
				<p set:html={copy.reviewP} />
				<figure class="ga-shot">
					<img src={shot('review')} width="1920" height="1200" loading="lazy" alt={copy.reviewAlt} />
				</figure>
			</div>
			<div class="ga-panel">
				<span class="ga-eyebrow">{copy.completionEyebrow}</span>
				<h3>{copy.completionH}</h3>
				<p>{copy.completionP}</p>
				<pre class="ga-code"><span class="k">@onready var</span> <span class="ghost">wave_label: Label = $HUD/WaveLabel</span>

<span class="k">func</span> _<span class="ghost">physics_process(delta: float) -&gt; void:</span></pre>
				<div class="ga-keys">
					<span><kbd>Tab</kbd> {copy.keys[0]}</span>
					<span><kbd>Ctrl</kbd>+<kbd>→</kbd> {copy.keys[1]}</span>
					<span><kbd>Alt</kbd>+<kbd>I</kbd> {copy.keys[2]}</span>
				</div>
			</div>
		</section>

		<section class="ga-section" aria-labelledby="h-rules">
			<div class="ga-head">
				<span class="ga-eyebrow">{copy.rulesEyebrow}</span>
				<h2 id="h-rules">{copy.rulesH}</h2>
			</div>
			<div class="ga-rules">
				{copy.rules.map(([never, why]) => <div class="ga-rule"><b>{never}</b><span>{why}</span></div>)}
			</div>
		</section>

		<section id="install" class="ga-section ga-install-wrap" aria-labelledby="h-install" style={`--pattern: url(${url('/godot-pattern.svg')})`}>
			<div class="hero-bg" aria-hidden="true"></div>
			<div class="ga-install">
				<div class="ga-install-left">
					<h2 id="h-install">{copy.installH}</h2>
					<p class="small" set:html={copy.req} />
					<div class="pills">
						<a class="pill" href={release}>{copy.downloadZip}</a>
						<a class="pill ghost" href={copy.gettingStartedUrl}>{copy.gettingStarted}</a>
					</div>
				</div>
				<ol>
					{copy.install.map((step) => <li set:html={step} />)}
				</ol>
			</div>
			<p class="small ga-fine">Godot Agent Harness {version} · MIT · <a href={copy.privacyUrl}>{copy.privacy}</a> · {copy.noTelemetry}</p>
		</section>
	</div>
</Base>

<style>
	/* One column of wide bands on the site's tokens; the editor's own colours only where the page quotes the editor. */
	.ga {
		--ok: #8fd18a;
		--warn: #f2c25c;
		--deny: #f27a6b;
