---
import Base from '../../layouts/Base.astro';
import AiTag from '../../components/AiTag.astro';
import profile from '../../../content/profile.json';
import { games, list, storeName, isCard, blurb, type Game } from '../../games';
import { t, url, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t[lang];
const { published, jams, other: otherGames, projects, lab } = await games();
const href = (g: Game) => url(`/${lang}/games/${g.id}/`);
const year = (g: Game) => (g.data.release_date ?? g.data.created)?.match(/\d{4}/)?.[0];
// What a work was made with, as the store reports it: itch's "Made with" or the repo's language.
const made = (g: Game) => [list(g.data.info?.['Made with'])?.split(', '), g.data.language].flat().filter(Boolean) as string[];
const sub = (g: Game) => [storeName[g.data.source], ...made(g), year(g)].filter(Boolean).join(' · ');
const rank = (g: Game) => {
	const r = g.data.jam?.results?.Overall?.rank;
	return r && `${s.rank} ${r}${g.data.jam?.entries ? ` ${s.of} ${g.data.jam.entries}` : ''}`;
};
const ai = (g: Game) => g.own?.ai || 'none';

const work = [...published, ...otherGames, ...projects];
const everything = [...work, ...jams, ...lab];
// The first screen shows what the CMS marks as featured: nothing, one work, or a carousel of several.
const featured = everything.filter((g) => g.own?.featured);

const levels = ['hand', 'assisted', 'vibe'] as const;
const count = Object.fromEntries(levels.map((k) => [k, everything.filter((g) => ai(g) === k).length]));
const filters = [
	['all', s.filterAll],
	['hand', s.filterHand],
	['assisted', s.filterAssisted],
	['vibe', s.filterVibe]
] as const;
const itch = profile.links.find((l) => l.url.includes('itch.io'));
---

<Base lang={lang} mode="home">
	<div class="home">
		<section class="hero" aria-labelledby="h-hero" style={`--pattern: url(${url('/godot-pattern.svg')})`}>
			<div class="hero-bg" aria-hidden="true"></div>
			<div class="hero-text">
				<h1 id="h-hero" data-rise>{s.heroTitle}</h1>
				<p class="hero-intro" data-rise>{s.heroIntro}</p>
				<p class="pills" data-rise>
					<a class="pill primary" href="#work">{s.seeWork} ↓</a>
					{itch && <a class="pill" href={itch.url}>{itch.label} ↗</a>}
				</p>
			</div>
			{
				featured.length > 0 && (
					<div class="hero-featured" data-rise>
						<div class="hero-track">
							{featured.map((g) => (
								<figure>
									<a href={href(g)}>
										{g.data.local_images.cover && <img class:list={{ gh: isCard(g) }} src={url(g.data.local_images.cover)} alt={g.data.title} width="1120" height="700" />}
									</a>
									<figcaption>
										<span><strong><a href={href(g)}>{g.data.title}</a>.</strong> {blurb(g, lang)}</span>
										<span class="muted">{year(g)}</span>
									</figcaption>
								</figure>
							))}
						</div>
						{featured.length > 1 && (
							<p class="pills hero-nav" hidden>
								<button type="button" class="pill" data-slide="-1" aria-label={s.previous}>←</button>
								<button type="button" class="pill" data-slide="1" aria-label={s.next}>→</button>
							</p>
						)}
					</div>
				)
			}
		</section>

		<section id="work" class="block filterable" aria-labelledby="h-work">
			<div class="block-head">
				<div>
					<h2 id="h-work" data-rise>{s.workTitle}</h2>
					<p class="count" data-rise>
						<span data-for="all"><strong>{everything.length} {s.works}:</strong> {count.hand} {s.counts.hand}, {count.assisted} {s.counts.assisted} {s.and} {count.vibe} {s.counts.vibe}.</span>
						{levels.map((k) => <span data-for={k}><strong>{count[k]} {s.of} {everything.length}:</strong> {s.legend[k][1]}</span>)}
					</p>
				</div>
				<div class="filter" role="group" aria-label={s.filterGroup} hidden>
					{filters.map(([k, label]) => <button type="button" data-filter={k} aria-pressed={String(k === 'all')}>{label}</button>)}
				</div>
			</div>
			<div class="work-rows">
				{
					work.map((g) => (
						<article class="work-row" data-ai={ai(g)} data-rise>
							<a class="work-img" href={href(g)} tabindex="-1" aria-hidden="true">
								{g.data.local_images.cover && <img class:list={{ gh: isCard(g) }} src={url(g.data.local_images.cover)} alt="" loading="lazy" width="960" height="540" />}
							</a>
							<div class="work-text">
								<h3><a href={href(g)}>{g.data.title}</a></h3>
								{blurb(g, lang) && <p>{blurb(g, lang)}</p>}
								<p class="meta"><span class="muted">{sub(g)}</span><AiTag lang={lang} level={g.own?.ai} /></p>
							</div>
						</article>
					))
				}
			</div>
			<p class="empty">{s.emptyFilter}</p>
		</section>

		{
			jams.length > 0 && (
				<section id="jams" class="block filterable" aria-labelledby="h-jams">
					<div class="block-head">
						<h2 id="h-jams" data-rise>{s.jams}</h2>
						<p class="block-lead" data-rise>{s.jamsLead}</p>
					</div>
					<div class="jam-rows">
						{jams.map((g) => (
							<a class="jam-row" href={href(g)} data-ai={ai(g)} data-rise>
								{g.data.local_images.cover && <img src={url(g.data.local_images.cover)} alt="" loading="lazy" width="320" height="200" />}
								<span class="jam-name">
									<span class="jam-title">{g.data.title}</span>
									<span>{g.data.jam?.name}{g.data.jam?.theme && ` · ${s.theme}: “${g.data.jam.theme}”`}</span>
								</span>
								<span class="jam-result">{rank(g)}</span>
								<AiTag lang={lang} level={g.own?.ai} />
							</a>
						))}
					</div>
					<p class="empty">{s.emptyFilter}</p>
				</section>
			)
		}

		<section id="lab" class="block lab filterable" aria-labelledby="h-lab">
			<div class="lab-head">
				<h2 id="h-lab" data-rise>{s.nav.lab}</h2>
				<p data-rise>{s.labIntro}</p>
			</div>
			<div class="lab-items">
				{
					lab.length > 0 ? (
						lab.map((g) => (
							<a class="lab-item" href={href(g)} data-ai={ai(g)} data-rise>
								{g.data.local_images.cover && <img class:list={{ gh: isCard(g) }} src={url(g.data.local_images.cover)} alt="" loading="lazy" width="640" height="480" />}
								<span class="lab-title">{g.data.title}</span>
								<span class="meta"><span class="muted">{sub(g)}</span><AiTag lang={lang} level={g.own?.ai} /></span>
							</a>
						))
					) : (
						<p>{s.labEmpty}</p>
					)
				}
				<p class="empty">{s.emptyFilter}</p>
			</div>
		</section>

		<section id="contact" class="block contact" aria-labelledby="h-contact" style={`--pattern: url(${url('/godot-pattern.svg')})`}>
			<div class="hero-bg" aria-hidden="true"></div>
			<div>
				<h2 id="h-contact" data-rise>{s.contactTitle}</h2>
				<p data-rise>{s.invite}</p>
			</div>
			<nav class="contact-links" aria-label={s.elsewhere} data-rise>
				{profile.links.map((l, i) => <a class:list={['pill', { primary: i === profile.links.length - 1 }]} href={l.url}>{l.label} ↗</a>)}
			</nav>
		</section>
	</div>
</Base>

<script>
	// Without this script the carousel still scrolls by touch or trackpad; the buttons only appear with it.
	const track = document.querySelector<HTMLElement>('.hero-track');
	const nav = document.querySelector<HTMLElement>('.hero-nav');
	if (track && nav) {
		nav.hidden = false;
		nav.querySelectorAll<HTMLButtonElement>('[data-slide]').forEach((button) => {
			button.addEventListener('click', () => {
				const count = track.children.length;
				const current = Math.round(track.scrollLeft / track.clientWidth);
				track.scrollLeft = ((current + Number(button.dataset.slide) + count) % count) * track.clientWidth;
			});
		});
	}
</script>
