---
import Base from '../../layouts/Base.astro';
import AiTag from '../../components/AiTag.astro';
import profile from '../../../content/profile.json';
import { games, list, storeName, isCard, type Game } from '../../games';
import { t, url, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t[lang];
const { published, jams, other: otherGames, projects, lab } = await games();
const href = (g: Game) => url(`/${lang}/games/${g.id}/`);
const year = (g: Game) => (g.data.release_date ?? g.data.created)?.match(/\d{4}/)?.[0];
// What a work was made with, as the store reports it: itch's "Made with" or the repo's language.
const made = (g: Game) => [list(g.data.info?.['Made with'])?.split(', '), g.data.language].flat().filter(Boolean) as string[];
const sub = (g: Game) => [storeName[g.data.source], year(g)].filter(Boolean).join(' · ');
const rank = (g: Game) => g.data.jam?.results?.Overall && `#${g.data.jam.results.Overall.rank}${g.data.jam.entries ? ` ${s.of} ${g.data.jam.entries}` : ''}`;

const work = [...published, ...otherGames, ...projects];
// The languages I name myself, then whatever the stores say the work was made with.
const tools = [...new Set([...s.facts[2][1].split(' · '), ...[...work, ...jams, ...lab].flatMap(made)])];
---

<Base lang={lang} mode="home">
	<div class="home">
		<section class="hero" aria-labelledby="h-hero" style={`--pattern: url(${url('/godot-pattern.svg')})`}>
			<div class="hero-bg" aria-hidden="true"></div>
			<h1 id="h-hero" data-rise>Daniel Rodriguez Aires</h1>
			<p class="hero-role" data-rise>{s.heroRole}</p>
			<p class="hero-line" data-rise>{s.heroLine}</p>
			<p class="pills hero-actions" data-rise>
				<a class="pill primary" href="#work">{s.workTitle} ↓</a>
				{published[0] && <a class="pill" href={published[0].data.url}>{published[0].data.title} · {storeName[published[0].data.source]} ↗</a>}
			</p>
		</section>

		<section id="work" class="band" aria-labelledby="h-work">
			<h2 id="h-work" data-rise>{s.workTitle}</h2>
			<div class="cards">
				{work.map((g) => (
					<a class="card" href={href(g)} data-rise>
						<span class="card-img">
							{g.data.local_images.cover && <img class:list={{ gh: isCard(g) }} src={url(g.data.local_images.cover)} alt="" loading="lazy" width="640" height="360" />}
							<span class="card-over">
								<AiTag lang={lang} level={g.own?.ai} />
								{made(g).length > 0 && <span class="chips">{made(g).map((m) => <span>{m}</span>)}</span>}
							</span>
						</span>
						<span class="card-title">{g.data.title}</span>
						<span class="small">{sub(g)}</span>
					</a>
				))}
			</div>
		</section>

		{
			jams.length > 0 && (
				<section id="jams" class="band" aria-labelledby="h-jams">
					<h2 id="h-jams" data-rise>{s.jams}</h2>
					<p class="band-lead" data-rise>{s.jamsHeading}</p>
					<div class="shelf" data-rise>
						{jams.map((g) => (
							<a class="slice" href={href(g)}>
								{g.data.local_images.cover && <img src={url(g.data.local_images.cover)} alt="" loading="lazy" width="630" height="500" />}
								<span class="slice-text">
									<span class="card-title">{g.data.title}</span>
									<span>{[g.data.jam?.name, rank(g)].filter(Boolean).join(' · ')}</span>
									<AiTag lang={lang} level={g.own?.ai} />
								</span>
							</a>
						))}
					</div>
				</section>
			)
		}

		<section id="lab" class="band" aria-labelledby="h-lab">
			<h2 id="h-lab" data-rise>{s.nav.lab}</h2>
			<p class="band-lead" data-rise>{s.labIntro}</p>
			{
				lab.length > 0 ? (
					<div class="cards small-cards">
						{lab.map((g) => (
							<a class="card" href={href(g)} data-rise>
								<span class="card-img">
									{g.data.local_images.cover && <img class:list={{ gh: isCard(g) }} src={url(g.data.local_images.cover)} alt="" loading="lazy" width="640" height="360" />}
								</span>
								<span class="card-title">{g.data.title}</span>
								<span class="small">{sub(g)}</span>
							</a>
						))}
					</div>
				) : (
					<p class="band-lead">{s.labEmpty}</p>
				)
			}
		</section>

		<section id="about" class="band about" aria-labelledby="h-about">
			<div class="about-text">
				<h2 id="h-about" data-rise>{s.about}</h2>
				{s.aboutText.map((p) => <p data-rise>{p}</p>)}
				<p class="legend-line" data-rise>
					{s.legendLead}
					{(['hand', 'assisted', 'vibe'] as const).map((k) => <AiTag lang={lang} level={k} />)}
				</p>
				<a class="pill primary" href="#contact" data-rise>{s.writeMe}</a>
			</div>
			<div class="about-tools">
				<h3 data-rise>{s.tools}</h3>
				<ul class="tools" data-rise>{tools.map((x) => <li>{x}</li>)}</ul>
			</div>
		</section>

		<section id="contact" class="contact" aria-labelledby="h-contact" style={`--pattern: url(${url('/godot-pattern.svg')})`}>
			<div class="hero-bg" aria-hidden="true"></div>
			<h2 id="h-contact" data-rise>{s.contact}</h2>
			<p data-rise>{s.invite}</p>
			<ul class="contact-links" data-rise>
				{profile.links.map((l) => <li><a href={l.url}>{l.label} ↗</a></li>)}
			</ul>
		</section>
	</div>
</Base>
