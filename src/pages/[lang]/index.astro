---
// The home page: its blocks are content/pages/home.json, edited in the admin under Páginas.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import { langPaths, type Lang } from '../../i18n';
import { tx } from '../../blocks/util';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const page = (await getEntry('pages', 'home'))!;
---

<Base lang={lang} title={tx(page.data.title, lang) || undefined} description={tx(page.data.description, lang) || undefined} image={page.data.image || undefined} mode="home">
	<Blocks blocks={page.data.blocks} lang={lang} />
</Base>
