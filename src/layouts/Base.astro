---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { t, other, url, type Lang } from '../i18n';

interface Props {
	lang: Lang;
	title?: string;
	// path after /<lang>/, so the language switch lands on the same page
	path?: string;
	// 'page': bar + content + footer; 'home': the page builds its own first screen; 'bare': content only
	mode?: 'page' | 'home' | 'bare';
	description?: string;
	// site-relative image for link previews; defaults to the site card
	image?: string;
}
const { lang, title, path = '', mode = 'page', description, image = '/og.png' } = Astro.props;
const s = t[lang];
const alt = other(lang);
const pageTitle = title ? `${title} · dann` : `dann · ${s.tagline}`;
const desc = description ?? `${s.tagline}. ${s.sub}`;
const canonical = new URL(url(`/${lang}/${path}`), Astro.site);
---

<!doctype html>
<html lang={lang} id="top">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={desc} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="dann" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={desc} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(url(image), Astro.site)} />
		<meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="alternate" hreflang={alt} href={new URL(url(`/${alt}/${path}`), Astro.site)} />
		<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={`dann · ${s.blog}`} href={url(`/${lang}/rss.xml`)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		{
			mode !== 'bare' && (
				<header class="bar">
					<a class="wordmark" href={url(`/${lang}/`)}>dann</a>
					<button type="button" class="menu-button" aria-label={s.menu} aria-expanded="false" aria-controls="site-nav">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18" /><path d="M3 12h18" /><path d="M3 18h18" /></svg>
					</button>
					<nav id="site-nav" class="nav" aria-label={s.navLabel}>
						<a href={url(`/${lang}/#work`)}>{s.nav.work}</a>
						<a href={url(`/${lang}/#jams`)}>{s.nav.jams}</a>
						<a href={url(`/${lang}/#lab`)}>{s.nav.lab}</a>
						<a href="#contact">{s.contact}</a>
						<a href={url(`/${lang}/blog/`)}>{s.nav.blog}</a>
						<a href={url(`/${alt}/${path}`)} hreflang={alt} lang={alt}>{alt.toUpperCase()}</a>
					</nav>
				</header>
			)
		}
		{mode === 'page' ? <main class="page"><slot /></main> : <slot />}
		{mode !== 'bare' && <Footer lang={lang} />}
		<script is:inline>
			// Entrances: the parts of each block rise in turn, once. Content stays visible without this script.
			const io = new IntersectionObserver((entries) => {
				for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
			}, { rootMargin: '0px 0px -10% 0px' });
			document.querySelectorAll('[data-rise]').forEach((el) => {
				const i = [...el.parentElement.children].filter((c) => c.hasAttribute('data-rise')).indexOf(el);
				el.style.setProperty('--d', `${i * 80}ms`);
				io.observe(el);
			});
			// Phone menu: any click outside the button closes it, links included. Without this script the links just show.
			const menu = document.querySelector('.menu-button');
			const setMenu = (open) => { menu?.setAttribute('aria-expanded', String(open)); menu?.parentElement.classList.toggle('open', open); };
			document.addEventListener('click', (e) => setMenu(!!menu?.contains(e.target) && menu.getAttribute('aria-expanded') !== 'true'));
			document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
			// Provenance filter: hides the works that don't match.
			document.querySelectorAll('[data-filter]').forEach((b, _, all) => {
				b.closest('[hidden]')?.removeAttribute('hidden');
				b.addEventListener('click', () => {
					document.documentElement.dataset.show = b.dataset.filter;
					all.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				});
			});
		</script>
	</body>
</html>
